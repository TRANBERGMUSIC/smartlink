{
  "name": "smartlink",
  "productName": "SmartLink",
  "version": "4.13.1",
  "description": "SmartLink – Art-Net styring af Laserworld DS-3000RGB MK5",
  "main": "src/main.js",
  "author": "Willads",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node tools/unpack-assets.js && node tools/make-remote.js && electron .",
    "dist": "node tools/unpack-assets.js && node tools/make-remote.js && electron-builder --mac zip --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dk.willads.smartlink",
    "productName": "SmartLink",
    "files": [
      "src/**/*",
      "!src/remote.template.html",
      "package.json",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/@huggingface/transformers/dist/transformers.node*",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/onnxruntime-web/dist/*.map",
      "!node_modules/sharp/**",
      "!node_modules/@img/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "SmartLink bruger kameraet til automatisk kalibrering af laserens placering."
      }
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.2",
    "qrcode": "^1.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TRANBERGMUSIC/lightlink.git"
  }
}
